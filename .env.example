TECH_RADAR_AGENT_ID=tech-radar
TECH_RADAR_AGENT_NAME="Tech Radar Analyst"
TECH_RADAR_DATA_PATH=data/sample_articles.jsonl
TECH_RADAR_TRACE_DIR=.runtime/traces
TECH_RADAR_KNOWLEDGE_BACKEND=fixture
TECH_RADAR_SERVER_HOST=127.0.0.1
TECH_RADAR_SERVER_PORT=8776
TECHNEWS_API_BASE_URL=http://127.0.0.1:8010
TECHNEWS_REQUEST_TIMEOUT=10
TECHNEWS_AUTH_TOKEN=
TECHNEWS_SESSION_COOKIE=

# Leave TECH_RADAR_MODEL empty to use the runtime-compatible provider settings.
TECH_RADAR_MODEL=
TECH_RADAR_LLM_PROVIDER=openai
TECH_RADAR_LLM_MODEL=gpt-5.5
TECH_RADAR_OPENAI_API_KEY=
TECH_RADAR_OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini follows the same provider names as traceable-agent-runtime.
# GEMINI_API_KEY and GOOGLE_API_KEY are also accepted.
TECH_RADAR_GEMINI_MODEL=gemini-2.5-flash
TECH_RADAR_GEMINI_API_KEY=
